{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "automerge": true,
  "automergeType": "branch",
  "customManagers": [
    {
      "customType": "regex",
      "datasourceTemplate": "deb",
      "managerFilePatterns": [
        "/\\.github/workflows/.*\\.ya?ml$/",
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "#\\s+renovate:\\s+datasource=deb(?:\\s+distro=(?<distro>\\S+))?\\s+depName=(?<depName>\\S+)\\s+suite=(?<suite>\\S+)\\s+APT_\\w+:\\s+(?<currentValue>[^\\n]+)",
        "#\\s+renovate:\\s+datasource=deb(?:\\s+distro=(?<distro>\\S+))?\\s+depName=(?<depName>\\S+)\\s+suite=(?<suite>\\S+)\\s+ENV\\s+\\S+_VERSION=\"(?<currentValue>[^\"]+)\""
      ],
      "registryUrlTemplate": "https://{{#if (equals distro 'ubuntu')}}archive.ubuntu.com/ubuntu{{else}}deb.debian.org/debian{{/if}}?suite={{suite}}&components=main,{{#if (equals distro 'ubuntu')}}multiverse,restricted,universe{{else}}contrib,non-free{{/if}}&binaryArch=amd64"
    },
    {
      "customType": "regex",
      "datasourceTemplate": "deb",
      "managerFilePatterns": [
        "/\\.github/workflows/.*\\.ya?ml$/",
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "#\\s+renovate:\\s+datasource=deb(?:\\s+distro=(?<distro>\\S+))?\\s+depName=(?<depName>\\S+)\\s+suite=(?<suite>\\S+)\\s+APT_\\w+:\\s+(?<currentValue>[^\\n]+)",
        "#\\s+renovate:\\s+datasource=deb(?:\\s+distro=(?<distro>\\S+))?\\s+depName=(?<depName>\\S+)\\s+suite=(?<suite>\\S+)\\s+ENV\\s+\\S+_VERSION=\"(?<currentValue>[^\"]+)\""
      ],
      "registryUrlTemplate": "https://{{#if (equals distro 'ubuntu')}}archive.ubuntu.com/ubuntu{{else}}deb.debian.org/debian{{/if}}?suite={{suite}}-updates&components=main,{{#if (equals distro 'ubuntu')}}multiverse,restricted,universe{{else}}contrib,non-free{{/if}}&binaryArch=amd64"
    },
    {
      "customType": "regex",
      "datasourceTemplate": "deb",
      "managerFilePatterns": [
        "/\\.github/workflows/.*\\.ya?ml$/",
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "#\\s+renovate:\\s+datasource=deb(?:\\s+distro=(?<distro>\\S+))?\\s+depName=(?<depName>\\S+)\\s+suite=(?<suite>\\S+)\\s+APT_\\w+:\\s+(?<currentValue>[^\\n]+)",
        "#\\s+renovate:\\s+datasource=deb(?:\\s+distro=(?<distro>\\S+))?\\s+depName=(?<depName>\\S+)\\s+suite=(?<suite>\\S+)\\s+ENV\\s+\\S+_VERSION=\"(?<currentValue>[^\"]+)\""
      ],
      "registryUrlTemplate": "https://{{#if (equals distro 'ubuntu')}}security.ubuntu.com/ubuntu{{else}}security.debian.org/debian-security{{/if}}?suite={{suite}}-security&components=main,{{#if (equals distro 'ubuntu')}}multiverse,restricted,universe{{else}}contrib,non-free{{/if}}&binaryArch=amd64"
    },
    {
      "customType": "regex",
      "datasourceTemplate": "docker",
      "managerFilePatterns": ["/\\.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": [
        "#\\s+renovate:\\s+datasource=docker\\s+depName=(?<depName>\\S+)\\s+\\S+:\\s+\"(?<currentValue>[^\"]+)\""
      ]
    },
    {
      "customType": "regex",
      "datasourceTemplate": "npm",
      "depNameTemplate": "mcr.microsoft.com/playwright",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["FROM mcr\\.microsoft\\.com/playwright:v(?<currentValue>\\S+)"],
      "packageNameTemplate": "@playwright/test"
    }
  ],
  "docker-compose": {
    "managerFilePatterns": [
      "/^src/(development/stack|production/production)\\.ya?ml$/"
    ]
  },
  "extends": [
    "config:best-practices",
    "group:allNonMajor",
    ":disableDependencyDashboard",
    ":semanticCommits",
    ":widenPeerDependencies"
  ],
  "git-submodules": {
    "enabled": true
  },
  "ignorePresets": [":ignoreModulesAndTests"],
  "major": {
    "automerge": false
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "a digest update is no riskier than a patch, so it joins the non-major group instead of opening one branch per image",
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch",
      "matchUpdateTypes": ["digest", "pinDigest"]
    },
    {
      "description": "a base image ends up in the built or deployed image, so its update releases like a runtime dependency",
      "matchManagers": ["docker-compose", "dockerfile"],
      "semanticCommitType": "fix"
    },
    {
      "description": "a patch of a 0.x version is offered beside its next minor",
      "group": {
        "branchTopic": "{{{replace '^patch-' '' groupSlug}}}"
      },
      "matchCurrentVersion": "/^v?0\\./",
      "separateMinorPatch": true
    },
    {
      "automerge": false,
      "description": "a minor of a 0.x version may break, so it gets its own pull request",
      "groupName": null,
      "matchCurrentVersion": "/^v?0\\./",
      "matchUpdateTypes": ["minor"]
    },
    {
      "major": {
        "enabled": true
      },
      "matchCategories": ["docker"]
    },
    {
      "description": "the playwright image is tracked through its npm package by a custom manager, which applies npm's minimum release age, so the image never updates without the package",
      "enabled": false,
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["mcr.microsoft.com/playwright"]
    },
    {
      "description": "a tag counts the year and its week, which only compare as numbers when split",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/observabilitystack/geoip-api"],
      "versioning": "regex:^(?<major>\\d{4})-(?<minor>\\d{2})$"
    },
    {
      "description": "docker versioning reads the PostGIS version in a tag as a suffix, so a newer one never matches",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["imresamu/postgis", "postgis/postgis"],
      "versioning": "regex:^(?<major>\\d+)-(?<minor>\\d+)\\.(?<patch>\\d+)(?<compatibility>-alpine)?$"
    },
    {
      "description": "docker versioning reads the build number in a tag as a suffix, so a newer one never matches",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/zammad/zammad"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<build>\\d+)$"
    },
    {
      "matchDepTypes": ["dependencies"],
      "rangeStrategy": "update-lockfile"
    },
    {
      "groupName": "playwright monorepo",
      "matchPackageNames": [
        "@playwright/test",
        "mcr.microsoft.com/playwright",
        "playwright-core"
      ]
    },
    {
      "groupName": "@dargmuesli/nuxt-vio",
      "matchPackageNames": [
        "@dargmuesli/nuxt-vio",
        "@dargmuesli/nuxt-vio-testing"
      ]
    }
  ],
  "printConfig": true,
  "schedule": ["before 6am on monday"],
  "timezone": "Europe/Berlin",
  "vulnerabilityAlerts": {
    "semanticCommitType": "fix"
  }
}
